//@version=6
indicator("Knoxville + Envelope Confluence", "Knox + ENV", overlay=true, max_bars_back=600, max_lines_count=500)

knoxLookback = input.int(100, "Knox Bars Back", minval=5, maxval=500, group="Knoxville Divergence")
rsiLength = input.int(14, "RSI Period", minval=1, group="Knoxville Divergence")
momentumLength = input.int(20, "Momentum Period", minval=1, group="Knoxville Divergence")
signalLookback = input.int(1, "Recent Signal Bars", minval=1, group="Confluence")
signalDirection = input.string("Bullish", "Direction", options=["Bullish", "Bearish", "Either"], group="Confluence")

envelopeLength = input.int(20, "Length", minval=1, maxval=500, group="Envelope")
envelopePercent = input.float(12.0, "Percent", minval=0.0, step=0.1, group="Envelope")
envelopeMaType = input.string("SMA", "MA Type", options=["SMA", "EMA"], group="Envelope")
envelopeMode = input.string("Lower support", "Condition", options=["Lower support", "Close below lower", "Upper resistance", "Close above upper", "Inside envelope"], group="Envelope")
proximityPct = input.float(2.0, "Support / Resistance Proximity %", minval=0.0, step=0.1, group="Envelope")
confirmationMode = input.string("Strong bullish close", "Reversal Confirmation", options=["Strong bullish close", "Disabled"], group="Confirmation")
confirmationWindow = input.int(3, "Confirmation Window", minval=0, maxval=10, group="Confirmation")
closeLocationThreshold = input.float(80.0, "Close Location %", minval=0.0, maxval=100.0, step=1.0, group="Confirmation")

momentum = ta.mom(close, momentumLength)
rsiValue = ta.rsi(close, rsiLength)

int barUp = 0
int barDown = 0
for i = 5 to knoxLookback
    if momentum < momentum[i]
        barUp := i
    if momentum > momentum[i]
        barDown := i

bool wasOverbought = false
if barUp > 0
    for j = 0 to barUp
        if rsiValue[j] > 70
            wasOverbought := true

bool wasOversold = false
if barDown > 0
    for j = 0 to barDown
        if rsiValue[j] < 30
            wasOversold := true

isHighest = high == ta.highest(high, knoxLookback)
isLowest = low == ta.lowest(low, knoxLookback)
bearishKnox = barUp > 0 and isHighest and wasOverbought and high > high[barUp]
bullishKnox = barDown > 0 and isLowest and wasOversold and low < low[barDown]

basis = envelopeMaType == "EMA" ? ta.ema(close, envelopeLength) : ta.sma(close, envelopeLength)
upper = basis * (1.0 + envelopePercent / 100.0)
lower = basis * (1.0 - envelopePercent / 100.0)
proximity = proximityPct / 100.0

lowerSupport = math.abs(low - lower) / lower <= proximity
upperResistance = math.abs(high - upper) / upper <= proximity
envelopeMatch = switch envelopeMode
    "Lower support" => lowerSupport
    "Close below lower" => close <= lower
    "Upper resistance" => upperResistance
    "Close above upper" => close >= upper
    => close >= lower and close <= upper

directionMatch = switch signalDirection
    "Bullish" => bullishKnox
    "Bearish" => bearishKnox
    => bullishKnox or bearishKnox

closeLocation = high == low ? 50.0 : (close - low) / (high - low) * 100.0
strongBullishClose = close > open and close > close[1] and closeLocation >= closeLocationThreshold
bullishSetup = bullishKnox and envelopeMatch
bearishSetup = bearishKnox and envelopeMatch
barsSinceBullishSetup = ta.barssince(bullishSetup)
bullishConfirmed = confirmationMode == "Disabled" ? bullishSetup : strongBullishClose and barsSinceBullishSetup >= 0 and barsSinceBullishSetup <= confirmationWindow
bullishConfluence = signalDirection != "Bearish" and bullishConfirmed
bearishConfluence = confirmationMode == "Disabled" and signalDirection != "Bullish" and bearishSetup
confluence = bullishConfluence or bearishConfluence
recentConfluence = ta.barssince(confluence) < signalLookback

if bullishKnox and barDown > 0
    line.new(bar_index - barDown, low[barDown], bar_index, low, xloc=xloc.bar_index, extend=extend.none, color=color.new(color.lime, 0), width=2)
if bearishKnox and barUp > 0
    line.new(bar_index - barUp, high[barUp], bar_index, high, xloc=xloc.bar_index, extend=extend.none, color=color.new(color.red, 0), width=2)

plot(basis, "Envelope Basis", color=color.new(color.orange, 0), linewidth=2)
upperPlot = plot(upper, "Envelope Upper", color=color.new(color.red, 15))
lowerPlot = plot(lower, "Envelope Lower", color=color.new(color.green, 15))
fill(upperPlot, lowerPlot, color=color.new(color.gray, 92))

plotshape(bullishKnox, title="Bullish Knoxville", style=shape.circle, location=location.belowbar, color=color.new(color.green, 0), size=size.tiny, text="+KD")
plotshape(bearishKnox, title="Bearish Knoxville", style=shape.circle, location=location.abovebar, color=color.new(color.red, 0), size=size.tiny, text="-KD")
plotshape(bullishSetup, title="Bullish Setup", style=shape.square, location=location.belowbar, color=color.new(color.yellow, 0), text="SET", textcolor=color.black, size=size.tiny)
plotshape(bullishConfluence, title="Bullish Confirmation", style=shape.labelup, location=location.belowbar, color=color.new(color.green, 0), text="CONF", textcolor=color.white, size=size.tiny)
plotshape(bearishConfluence, title="Bearish Confluence", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0), text="SELL", textcolor=color.white, size=size.tiny)

plot(confluence ? 1 : 0, "Confluence Signal", display=display.data_window)
plot(recentConfluence ? 1 : 0, "Recent Confluence", display=display.data_window)
alertcondition(bullishConfluence, "Bullish Knox + Envelope Confirmed", "Bullish Knoxville and Envelope setup confirmed on {{ticker}}")
alertcondition(bearishConfluence, "Bearish Knox + Envelope", "Bearish Knoxville and Envelope confluence on {{ticker}}")
