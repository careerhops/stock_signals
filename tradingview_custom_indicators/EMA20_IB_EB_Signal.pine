//@version=6
indicator("EMA20 Exact Red-Green IB EB v6", overlay=true)

// ============================================================
// INPUTS
// ============================================================

emaLength = input.int(20, "EMA Length", minval=1)

showBandFill = input.bool(true, "Fill EMA Band")
showIB = input.bool(true, "Show IB")
showEB = input.bool(true, "Show EB")

forceStandardColors = input.bool(
     true,
     "Force Red/Green Candle Colors")

showPairMarkers = input.bool(
     false,
     "Debug: Mark Red-Green Pair")


// ============================================================
// EMA 20 HIGH / LOW / CLOSE
// ============================================================

emaHigh = ta.ema(high, emaLength)
emaLow = ta.ema(low, emaLength)
emaClose = ta.ema(close, emaLength)


// ============================================================
// EMA PLOTS
// ============================================================

pHigh = plot(
     emaHigh,
     title="EMA20 High",
     color=color.red,
     linewidth=2)

pLow = plot(
     emaLow,
     title="EMA20 Low",
     color=color.green,
     linewidth=2)

plot(
     emaClose,
     title="EMA20 Close",
     color=color.yellow,
     linewidth=2)

fill(
     pHigh,
     pLow,
     color=showBandFill ? color.new(color.blue, 90) : na)


// ============================================================
// FORCE STANDARD CANDLE COLORS
//
// GREEN = Close > Open
// RED   = Close < Open
// ============================================================

standardColor =
     close > open ? color.teal :
     close < open ? color.red :
     color.gray

barcolor(
     forceStandardColors ?
     standardColor :
     na)


// ============================================================
// EXACT 2-BAR PATTERN
//
// [1] = IMMEDIATELY PREVIOUS BAR
// [0] = CURRENT BAR
// ============================================================

// Previous bar MUST be RED
prevRed =
     close[1] < open[1]

// Current bar MUST be GREEN
currGreen =
     close > open


// ============================================================
// BOTH BARS MUST BE ENTIRELY BELOW EMA20 LOW
//
// Entire candle including wick:
//
// HIGH < EMA20 LOW
// ============================================================

prevFullyBelow =
     high[1] < emaLow[1]

currFullyBelow =
     high < emaLow

bothFullyBelow =
     prevFullyBelow and
     currFullyBelow


// ============================================================
// MASTER CONDITION
//
// EXACTLY:
//
// Previous candle RED
// Immediately next candle GREEN
// Both completely below EMA20 Low
// ============================================================

validRedGreenPair =
     prevRed and
     currGreen and
     bothFullyBelow


// ============================================================
// INSIDE BAR
//
// Green bar fully INSIDE previous red bar.
//
// Current High < Previous High
// Current Low  > Previous Low
// ============================================================

rangeInside =
     high < high[1] and
     low > low[1]

IB =
     barstate.isconfirmed and
     validRedGreenPair and
     rangeInside


// ============================================================
// ENGULFING BAR
//
// Green bar fully OUTSIDE previous red bar.
//
// Current High > Previous High
// Current Low  < Previous Low
// ============================================================

rangeEngulf =
     high > high[1] and
     low < low[1]

EB =
     barstate.isconfirmed and
     validRedGreenPair and
     rangeEngulf


// ============================================================
// SIGNAL MARKERS
//
// Marker is attached to CURRENT GREEN candle.
// ============================================================

plotshape(
     showIB and IB,
     title="Bullish Inside Bar",
     style=shape.labelup,
     location=location.belowbar,
     color=color.aqua,
     text="IB",
     textcolor=color.black,
     size=size.small)

plotshape(
     showEB and EB,
     title="Bullish Engulfing Bar",
     style=shape.labelup,
     location=location.belowbar,
     color=color.lime,
     text="EB",
     textcolor=color.black,
     size=size.small)


// ============================================================
// OPTIONAL DEBUG
//
// RED triangle = previous red candle
// GREEN triangle = current green candle
//
// These appear ONLY when a valid pair exists.
// ============================================================

plotshape(
     showPairMarkers and validRedGreenPair,
     title="Current Green Pattern Bar",
     style=shape.triangleup,
     location=location.belowbar,
     color=color.lime,
     size=size.tiny)

plotshape(
     showPairMarkers and validRedGreenPair,
     title="Previous Red Pattern Bar",
     style=shape.triangledown,
     location=location.abovebar,
     color=color.red,
     size=size.tiny,
     offset=-1)


// ============================================================
// DATA WINDOW DEBUG
// ============================================================

plot(
     prevRed ? 1 : 0,
     title="Previous = RED",
     display=display.data_window)

plot(
     currGreen ? 1 : 0,
     title="Current = GREEN",
     display=display.data_window)

plot(
     prevFullyBelow ? 1 : 0,
     title="Previous Fully Below EMA Low",
     display=display.data_window)

plot(
     currFullyBelow ? 1 : 0,
     title="Current Fully Below EMA Low",
     display=display.data_window)

plot(
     validRedGreenPair ? 1 : 0,
     title="Valid Red-Green Pair",
     display=display.data_window)

plot(
     IB ? 1 : 0,
     title="IB",
     display=display.data_window)

plot(
     EB ? 1 : 0,
     title="EB",
     display=display.data_window)